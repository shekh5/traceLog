# TraceLog environment template. Copy to .env and fill in.
# Real secrets live in Secret Manager in deployed environments (NFR-4); .env is local-only.

# --- OpenAI GPT-5.6 ---
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5.6-sol
EVALUATOR_MODEL=gpt-5.6-terra
PATIENT_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
EVALUATOR_REASONING_EFFORT=low
PATIENT_REASONING_EFFORT=low
OPENAI_STORE_RESPONSES=false
OPENAI_TIMEOUT_SECONDS=300
OPENAI_MAX_RETRIES=5

# --- Arize Phoenix (partner MCP) ---
PHOENIX_BASE_URL=https://app.phoenix.arize.com
PHOENIX_API_KEY=replace-me
# How TraceLog reaches the Phoenix MCP server. Default = the official npx package.
# SPIKE-RECONCILE: confirm command/transport during the Day-1 MCP enumeration spike.
PHOENIX_MCP_COMMAND=npx
PHOENIX_MCP_ARGS=-y,@arizeai/phoenix-mcp@latest

# Phoenix project names
PATIENT_PROJECT=patient-prod         # the victim agent's traces
META_PROJECT=tracelog-meta          # TraceLog's own self-observability (NFR-3)

# --- TraceLog tuning ---
POLL_INTERVAL_SECONDS=60             # FR-W1
DIAGNOSIS_CONFIDENCE_THRESHOLD=0.7   # FR-D3
SYNTH_DATASET_SIZE=12                # FR-S1
DEMO_EVAL_CASES=4
REDTEAM_HOLDOUT_CASES=6
REDTEAM_MIN_VALID_HOLDOUTS=3         # fewer valid probes can never count as verified

# Judge-safe deterministic dashboard playback. No OpenAI, Patient, or Phoenix calls.
# Keep false for real supervision; set true only for the visibly labelled fixture demo.
OFFLINE_DEMO_MODE=false
OFFLINE_DEMO_DELAY_SECONDS=0.65

# --- Introspection / on-product depth ---
SELF_TRACE_ENABLED=true              # trace TraceLog's own reasoning into META_PROJECT
PHOENIX_EXPERIMENTS_ENABLED=false    # also register the A/B as a real Phoenix experiment

# --- State backend ---
STATE_BACKEND=local                  # Cloud Run overrides this to firestore
FIRESTORE_COLLECTION=tracelog_state

# --- Dashboard ---
DASHBOARD_PORT=8085
PATIENT_ENDPOINT=http://localhost:8082/chat

# --- Supervised agent ("Patient") integration — bring your own agent ---
# BASELINE_PROMPT_FILE: file holding the supervised agent's CURRENT system prompt.
# Resolution order (tracelog/baseline.py): this file -> the failing span's
# llm.input_messages system message -> the bundled demo ShopBot prompt.
# BASELINE_PROMPT_FILE=prompts/system_prompt.txt
# PATIENT_PROMPT_NAME: Phoenix prompt name candidate patches are versioned under.
# PATIENT_PROMPT_NAME=patient-shopbot-system

# --- Security ---
# Shared secret for the Patient's system_override path. REQUIRED on any public
# deployment (set the same value on both the dashboard/TraceLog and Patient services,
# via Secret Manager). Leave unset for local dev.
# REPLAY_SHARED_SECRET=change-me
# Bearer token for Patient /chat and dashboard /ask + /selfeval. Set the same
# value on both services. Leave unset only for local development or upstream IAM.
# SERVICE_API_KEY=change-me-too
